    "@deepseek-ai/dsh-session-log-export": "workspace:*",
    "@deepseek-ai/dsh-session-reference": "workspace:*",
    "@deepseek-ai/dsh-session-stats": "workspace:*",
    "@deepseek-ai/dsh-session-turn-outline": "workspace:*",
    "@deepseek-ai/dsh-tool-ask-user": "workspace:*",
    "@deepseek-ai/dsh-tool-present": "workspace:*",
    "@deepseek-ai/dsh-user-questions": "workspace:*",
    "@deepseek-ai/dsh-util-values": "workspace:*",
    "@deepseek-ai/dsh-workspace-changes": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@earendil-works/pi-tui": "^0.85.1",
    "@shikijs/langs": "^4.3.1",
    "@shikijs/themes": "^4.3.1",
    "commander": "^15.0.0",
    "shiki": "^4.3.1"
